{
  "$id": "urn:vqro.collections:document-action:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action_id": {
            "const": "vqro.collections.label.set"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/label_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_id": {
            "enum": [
              "vqro.collections.terminal.archive",
              "vqro.collections.terminal.unarchive"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/terminal_payload"
          }
        }
      }
    }
  ],
  "description": "Dependencies must be strictly sorted and unique. Exactly one host.state.v1 dependency must equal the state identity tuple under the host state dependency convention; the package decoder enforces these non-structural rules.",
  "properties": {
    "action_id": {
      "enum": [
        "vqro.collections.label.set",
        "vqro.collections.terminal.archive",
        "vqro.collections.terminal.unarchive"
      ]
    },
    "authority_generation": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "type": "integer"
    },
    "contract": {
      "const": "vqro.collections.document-action.v1"
    },
    "document_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "type": "string"
    },
    "observed_dependencies": {
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "package_id": {
      "const": "vqro.collections"
    },
    "payload": true,
    "service_id": {
      "const": "collections"
    },
    "state": {
      "$ref": "#/$defs/state"
    }
  },
  "required": [
    "contract",
    "package_id",
    "service_id",
    "document_id",
    "action_id",
    "payload",
    "observed_dependencies",
    "authority_generation",
    "state"
  ],
  "type": "object",
  "$defs": {
    "container_id": {
      "not": {
        "enum": [
          "container_0000000000000000",
          "container_ffffffffffffffff"
        ]
      },
      "pattern": "^container_[0-9a-f]{16}$",
      "type": "string"
    },
    "dependency": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "maxLength": 128,
          "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$",
          "type": "string"
        },
        "generation": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "revision": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "scope_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:/-]+$",
          "type": "string"
        }
      },
      "required": [
        "contract",
        "scope_id",
        "revision",
        "generation"
      ],
      "type": "object"
    },
    "label_payload": {
      "additionalProperties": false,
      "properties": {
        "container_id": {
          "$ref": "#/$defs/container_id"
        },
        "label": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 4096,
              "type": "string",
              "description": "Runtime additionally enforces 4096 UTF-8 bytes."
            }
          ]
        }
      },
      "required": [
        "container_id",
        "label"
      ],
      "type": "object"
    },
    "terminal_payload": {
      "additionalProperties": false,
      "properties": {
        "container_id": {
          "$ref": "#/$defs/container_id"
        },
        "terminal_id": {
          "pattern": "^term_[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "container_id",
        "terminal_id"
      ],
      "type": "object"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/container_id"
        },
        "namespace": {
          "const": "vqro.collections"
        },
        "revision": {
          "maximum": 18446744073709551614,
          "minimum": 0,
          "type": "integer"
        },
        "store_generation": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "type": "integer"
        },
        "store_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/policy"
            }
          ]
        }
      },
      "required": [
        "namespace",
        "store_id",
        "store_generation",
        "revision",
        "key",
        "value"
      ],
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "archived_terminal_ids": {
          "items": {
            "pattern": "^term_[0-9a-f]{32}$",
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "container_id": {
          "$ref": "#/$defs/container_id"
        },
        "label": {
          "description": "Runtime additionally enforces 4096 UTF-8 bytes.",
          "maxLength": 4096,
          "type": "string"
        },
        "schema": {
          "const": "vqro.collections.policy"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "schema_version",
        "container_id",
        "archived_terminal_ids"
      ],
      "type": "object"
    }
  },
  "x-semantic-invariants": [
    "label is at most 4096 UTF-8 bytes; JSON Schema maxLength is only a structural precheck",
    "dependencies are strictly sorted and unique",
    "the sole host.state.v1 dependency equals the state store identity, revision + 1, and generation",
    "policy container_id equals state.key and archived_terminal_ids are strictly sorted"
  ]
}
